# Static server for the Docker cells (Railway, Fly). Render and Vercel serve the same `public/` from their CDN.
{
	admin off
	auto_https off
}

:{$PORT:80} {
	root * /srv
	encode zstd gzip
	# Not for search engines: the site is a copy of kubernetes.io for benchmark runs only.
	header X-Robots-Tag "noindex, nofollow"
	rewrite /version /version.json
	file_server
}

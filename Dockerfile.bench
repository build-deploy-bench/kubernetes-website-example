# Image for the Docker cells of the benchmark (Railway, Fly). Render and Vercel build the same site with
# `bench/build.sh` on their native static hosting. Upstream's `Dockerfile` is its Hugo dev container and is not used.
# bench/build.sh downloads Hugo and Node itself, as on Render and Vercel; this base image only adds curl and git.
FROM buildpack-deps:bookworm-scm AS build

WORKDIR /src
# Install inputs only, so the install layer stays cached when only the content changes.
COPY package.json package-lock.json ./
COPY bench/build.sh bench/
RUN ./bench/build.sh install

# Declared after the install step: a build arg that changes with every commit would also invalidate that layer.
# Fly passes BENCH_COMMIT; Railway passes RAILWAY_GIT_COMMIT_SHA to a stage that declares it.
ARG BENCH_COMMIT
ARG RAILWAY_GIT_COMMIT_SHA
COPY . .
RUN ./bench/build.sh build

FROM caddy:2.10.2-alpine
ENV PORT=80
# GNU date for millisecond markers; BusyBox date has no %N.
RUN apk add --no-cache coreutils
COPY bench/Caddyfile /etc/caddy/Caddyfile
COPY bench/serve.sh /usr/local/bin/bench-serve
COPY --from=build /src/public /srv
EXPOSE 80
CMD ["/usr/local/bin/bench-serve"]
